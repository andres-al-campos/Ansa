#!/usr/bin/env bash
#
# Before a push: the TypeScript suite (laws 1–3 included), and law 4 only when
# the push changes an op on either side, since its answer can't change otherwise.
# ./build.sh check runs everything; this is the part fast enough to run every time.
# Skip once with: git push --no-verify

set -euo pipefail
cd "$(git rev-parse --show-toplevel)"

OP_FILES=(
  shared/ops.ts shared/tree.ts
  ios/AnsaCore/Sources/AnsaCore/Tree.swift
  ios/AnsaCore/Sources/AnsaCore/TreeMoves.swift
  ios/AnsaCore/Sources/AnsaCore/Ops.swift
)
zero=0000000000000000000000000000000000000000

touches_ops=false
while read -r _ local_sha _ remote_sha; do
  [ "$local_sha" = "$zero" ] && continue # deleting a branch
  if [ "$remote_sha" = "$zero" ]; then
    # A new branch: compare with what the remote's main already has.
    base=$(git merge-base "$local_sha" origin/main 2>/dev/null || true)
  else
    base=$remote_sha
  fi
  if [ -z "$base" ] || [ -n "$(git diff --name-only "$base" "$local_sha" -- "${OP_FILES[@]}")" ]; then
    touches_ops=true
  fi
done

echo "pre-push: TypeScript tests …"
npm test --silent

if $touches_ops; then
  if command -v swift >/dev/null 2>&1; then
    echo "pre-push: this push changes an op, so checking Swift and TypeScript agree …"
    ios/build.sh agree
  else
    echo "pre-push: this push changes an op, but swift isn't installed, so law 4 is skipped." >&2
    echo "Run ios/build.sh agree on a Mac with Xcode before relying on the iOS app." >&2
  fi
fi
