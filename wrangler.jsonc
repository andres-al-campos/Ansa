{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ansa",
  "main": "worker/src/index.ts",
  // Workers runs a recent V8 with node compatibility for the APIs @clerk/backend
  // reaches for. The date pins runtime behaviour so a redeploy months from now
  // doesn't silently pick up different semantics.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "ANSA_TREE", "class_name": "AnsaTree" }]
  },

  "migrations": [
    {
      "tag": "v1",
      // new_sqlite_classes, not new_classes. The key-value backend it would
      // otherwise get is unavailable on the free plan, and this object's whole
      // design is one SQLite database per owner.
      "new_sqlite_classes": ["AnsaTree"]
    }
  ],

  "vars": {
    // The Pages origins the app is served from, comma-separated. Anything not
    // listed gets no CORS headers — see cors.ts for why this doesn't default
    // open.
    //
    // Only the production origin is listed. Every Pages deployment also gets a
    // per-deployment preview URL (579b9074.ansaflow.pages.dev), and those are
    // deliberately absent: the hash changes on every deploy, so keeping them
    // working would mean allowing *.pages.dev — which is every Pages site on
    // Cloudflare, not just this one. Test against the production URL.
    "ANSA_ALLOWED_ORIGIN": "https://ansaflow.pages.dev"

    // The Clerk user id the MCP server's token acts as. Uncomment and set it to
    // your own `user_xxx` to give a headless client access to your tree — see
    // "Giving it access to your real tree" in the README.
    //
    // Not a secret: on its own it authenticates nobody, since the token's hash
    // in ANSA_MCP_TOKEN_SHA256 is the half that grants anything. Visible here so
    // a worker that answers as the wrong account can be diagnosed by reading the
    // config rather than by guessing.
    // "ANSA_MCP_USER": "user_xxxxxxxxxxxxxxxxxxxxxxxxx"
  }

  // CLERK_SECRET_KEY is a secret, not a var: `wrangler secret put
  // CLERK_SECRET_KEY`. It must never appear in this file, which is committed.
  //
  // ANSA_DEV_AUTH belongs only in .dev.vars (gitignored, local only). A
  // deployed worker carrying it refuses every request — see misconfiguredAuth.
}
