{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ansa",
  "main": "worker/src/index.ts",
  // Workers runs a recent V8 with node compatibility for the APIs @clerk/backend
  // reaches for. The date pins runtime behaviour so a redeploy months from now
  // doesn't silently pick up different semantics.
  "compatibility_date": "2026-08-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },

  "durable_objects": {
    "bindings": [{ "name": "ANSA_TREE", "class_name": "AnsaTree" }]
  },

  "migrations": [
    {
      "tag": "v1",
      // new_sqlite_classes, not new_classes. The key-value backend it would
      // otherwise get is unavailable on the free plan, and this object's whole
      // design is one SQLite database per owner.
      "new_sqlite_classes": ["AnsaTree"]
    }
  ],

  "vars": {
    // The origins the app is served from, comma-separated. Anything not listed
    // gets no CORS headers — see cors.ts for why this doesn't default open.
    //
    // First is the production Pages origin. Every Pages deployment also gets a
    // per-deployment preview URL (579b9074.ansaflow.pages.dev), and those are
    // deliberately absent: the hash changes on every deploy, so keeping them
    // working would mean allowing *.pages.dev — which is every Pages site on
    // Cloudflare, not just this one. Test against the production URL.
    //
    // Second is the desktop app. It serves the same bundle from a loopback
    // server on a fixed port (see desktop/main.js PORT), so its origin is stable
    // and can be named here; without it the renderer's fetches to this API are
    // CORS-blocked. Loopback means the browser it runs in is Electron's own, on
    // the user's machine — not a page that a stranger's site could open.
    "ANSA_ALLOWED_ORIGIN": "https://ansaflow.pages.dev,http://127.0.0.1:41407"

    // ANSA_MCP_USER, the Clerk user id the MCP token acts as, is in the secret
    // store beside ANSA_MCP_TOKEN_SHA256. It authenticates nobody on its own;
    // it stays out of this file because the repo is public and the id is one
    // person's account. See "Giving it access to your real tree" in the README.
  }

  // CLERK_SECRET_KEY is a secret, not a var: `wrangler secret put
  // CLERK_SECRET_KEY`. It must never appear in this file, which is committed.
  //
  // ANSA_DEV_AUTH is set only by build.sh's local run, never here. A
  // deployed worker carrying it refuses every request — see misconfiguredAuth.
}
