# Local worker vars (dev auth stub; never committed)
.dev.vars

# Wrangler local state (DO SQLite for wrangler dev, build cache)
.wrangler/

# Swift / Xcode build output and per-user state
.build/
DerivedData/
*.xcuserstate
xcuserdata/

# iOS: generated project and local signing config
ios/Ansa.xcodeproj/
ios/Config.xcconfig
ios/build/
.scratch/

# Mockups and design explorations. The end result is the code; the process
# behind it is not something a clone needs. The files stay on disk in designs/
# — this only keeps new ones out of git. The handful committed before this rule
# are left alone rather than rewriting history for them.
designs/

# Desktop (Electron) build output and the web bundle build.sh copies in
desktop/dist/
desktop/web/
