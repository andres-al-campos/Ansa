{
  "name": "ansa",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "preserver": "pid=$(lsof -tiTCP:${PORT:-4000} -sTCP:LISTEN 2>/dev/null | head -1); if [ -n \"$pid\" ]; then echo \"Port ${PORT:-4000} is already in use by pid $pid — an Ansa server is probably already running.\" >&2; echo \"Stop it (Ctrl-C its terminal), or: kill $pid\" >&2; exit 1; fi",
    "server": "tsx watch server/src/index.ts",
    "start": "tsx server/src/index.ts",
    "mcp": "tsx mcp/src/index.ts",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b && tsc --noEmit -p worker",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@clerk/backend": "^3.15.1",
    "@clerk/clerk-react": "^5.61.9",
    "@fastify/cors": "^11.3.0",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "better-sqlite3": "^13.0.1",
    "fastify": "^5.10.0",
    "react": "^19.2.0",
    "react-dom": "^19.2.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^5.20260804.1",
    "@fastify/static": "^10.1.2",
    "@testing-library/dom": "^10.4.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^26.1.1",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.1.0",
    "jsdom": "^29.1.1",
    "tsx": "^4.23.1",
    "typescript": "^5.9.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
